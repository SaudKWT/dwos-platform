# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; `.env.example` is committed as a template.

# AISStream.io — free WebSocket streaming (https://aisstream.io)
# Sign up to get an API key (no credit card required).
AISSTREAM_API_KEY=your_aisstream_api_key_here

# MMSIs of the 4 vessels we track.
AIS_MMSI_JUNO=636025030
AIS_MMSI_CA1=538010097
AIS_MMSI_CA3=538010098
AIS_MMSI_CA5=538010099

# Kuwait / Northern Persian Gulf bounding box used for WebSocket subscription:
#   [[lat_min, lon_min], [lat_max, lon_max]]
AIS_BBOX_LAT_MIN=28.0
AIS_BBOX_LON_MIN=47.0
AIS_BBOX_LAT_MAX=30.0
AIS_BBOX_LON_MAX=49.5
