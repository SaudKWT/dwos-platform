# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; `.env.example` is committed as a template.

AIS_PROVIDER=datadocked
AIS_API_KEY=your_datadocked_api_key_here
AIS_BASE_URL=https://datadocked.com/api

# MMSIs for the 4 tracked vessels (leave blank until known)
AIS_MMSI_JUNO=
AIS_MMSI_CA1=
AIS_MMSI_CA3=
AIS_MMSI_CA5=

# REST polling cadence (seconds)
AIS_POLL_SECONDS=30
