# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; `.env.example` is committed as a template.

# AISStream.io — free WebSocket streaming (https://aisstream.io)
# Sign up to get an API key (no credit card required).
# NOTE: AISStream has no terrestrial AIS receiver coverage in the Persian Gulf,
# so it's parked for now. Keep the key around in case coverage changes.
AISSTREAM_API_KEY=your_aisstream_api_key_here

# Datalastic — paid AIS history + live (https://datalastic.com)
# Sign up for the 14-day trial (€9, refundable). Used by:
#   tools/validate_ais_provider.py    — probe Gulf coverage before committing
#   tools/import_ais_history.py       — pull /vessel_history per MMSI
# 1 credit per vessel-day, so backfilling 4 vessels × 7 days costs 28 credits.
DATALASTIC_API_KEY=your_datalastic_api_key_here

# VT Explorer (optional fallback — https://www.vtexplorer.com)
# 7-day free trial, €50/mo terrestrial. Historical-by-MMSI is manual quote,
# so this key is only useful if VT Explorer adds a public history API later
# or for live tracking subscriptions.
VTEXPLORER_API_KEY=your_vtexplorer_api_key_here

# MMSIs of the vessels we track.
# JUNO retired 2026-05-20, replaced by Charlie 3 (CH3).
AIS_MMSI_JUNO=636025030
# Charlie 3 — IMO 9889928. Public trackers list it as an offshore tug/supply
# vessel (built 2020), not a crew boat — confirm it's the right hull against
# daily reports once fixes flow (tools/crosscheck_reports.py).
AIS_MMSI_CH3=341930000
AIS_MMSI_CA1=538010097
AIS_MMSI_CA3=538010098
AIS_MMSI_CA5=538010099

# Kuwait / Northern Persian Gulf bounding box used for WebSocket subscription:
#   [[lat_min, lon_min], [lat_max, lon_max]]
AIS_BBOX_LAT_MIN=28.0
AIS_BBOX_LON_MIN=47.0
AIS_BBOX_LAT_MAX=30.0
AIS_BBOX_LON_MAX=49.5
